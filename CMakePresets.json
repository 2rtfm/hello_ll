{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {}
    },
    {
      "name": "Debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "LLVM_Debug",
      "inherits": "Debug",
      "toolchainFile": "${sourceDir}/cmake/clang.cmake"
    },
    {
      "name": "LLVM_Release",
      "inherits": "Release",
      "toolchainFile": "${sourceDir}/cmake/clang.cmake"
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "Debug",
      "jobs": 8
    },
    {
      "name": "Release",
      "configurePreset": "Release",
      "jobs": 8
    },
    {
      "name": "LLVM_Debug",
      "configurePreset": "LLVM_Debug",
      "jobs": 8
    },
    {
      "name": "LLVM_Release",
      "configurePreset": "LLVM_Release",
      "jobs": 8
    }
  ]
}
